{
  "name": "@cunpingtai/ad-traffic-guard",
  "version": "0.2.1",
  "description": "AdSense eligibility orchestrator: isbot + BotD + visibility/engagement gating before loading ads. Default passthrough mode currently allows all ads.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "cunpingtai",
  "homepage": "https://github.com/cunpingtai/ad-traffic-guard#readme",
  "bugs": {
    "url": "https://github.com/cunpingtai/ad-traffic-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cunpingtai/ad-traffic-guard.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./detectors": {
      "types": "./dist/detectors/index.d.ts",
      "import": "./dist/detectors/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist .tmp-test",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@fingerprintjs/botd": "^2.0.0",
    "isbot": "^5.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "adsense",
    "invalid-traffic",
    "lazy-load",
    "advertising",
    "bot",
    "botd",
    "isbot",
    "nextjs",
    "react"
  ],
  "engines": {
    "node": ">=18"
  }
}
